<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp" android:background="#1E1E2F">
    <EditText android:id="@+id/etName" android:hint="Nom du contact" android:background="@drawable/input_bg" android:textColor="#FFFFFF" android:textColorHint="#888888" android:padding="14dp" android:layout_marginBottom="12dp"/>
    <EditText android:id="@+id/etNumber" android:hint="Numero de telephone" android:inputType="phone" android:background="@drawable/input_bg" android:textColor="#FFFFFF" android:textColorHint="#888888" android:padding="14dp"/>
</LinearLayout>
