<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF0F5"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:spacing="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💖 Journal Intime"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FF69B4"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3 secrets enregistres ✨"
            android:textSize="14sp"
            android:textColor="#888888"
            android:gravity="center"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Rechercher un secret..."
            android:background="#FFFFFF"
            android:padding="12dp"
            android:textColor="#333333"
            android:layout_marginTop="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:spacing="8dp"
            android:layout_marginTop="8dp">

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tous ✨"
                android:backgroundTint="#FF1493"
                android:textColor="#FFFFFF"/>

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Recents"
                android:backgroundTint="#FFFFFF"
                android:textColor="#FF1493"
                android:strokeColor="#FF1493"
                android:strokeWidth="2dp"/>

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Favoris"
                android:backgroundTint="#FFFFFF"
                android:textColor="#FF1493"
                android:strokeColor="#FF1493"
                android:strokeWidth="2dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:background="#E8EAF6"
            android:padding="16dp"
            android:cornerRadius="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📌 Mon premier secret"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#303F9F"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ceci est mon contenu secret..."
                android:textSize="14sp"
                android:textColor="#555555"
                android:layout_marginTop="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="04 aout 11:07"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:background="#E8F5E9"
            android:padding="16dp"
            android:cornerRadius="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎀 Note vocale"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Appuie pour ecouter 🎤"
                android:textSize="14sp"
                android:textColor="#555555"
                android:layout_marginTop="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="31 juil. 23:03"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+ Nouveau secret 💖"
            android:backgroundTint="#FF1493"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16dp"/>

    </LinearLayout>
</ScrollView>
