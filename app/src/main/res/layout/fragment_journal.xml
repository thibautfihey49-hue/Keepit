<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF0F5"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:spacing="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💖 Mon Journal Intime"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FF1493"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tes secrets sont sauvegardes en securite"
            android:textSize="14sp"
            android:textColor="#888888"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="➕ Nouvelle note"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FF1493"
            android:layout_marginTop="8dp"/>

        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Titre..."
            android:background="#FFFFFF"
            android:padding="12dp"
            android:textColor="#333333"
            android:inputType="textCapSentences"/>

        <EditText
            android:id="@+id/etContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ecris ton secret..."
            android:minLines="5"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:textColor="#333333"/>

        <Button
            android:id="@+id/btnSaveNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💾 Sauvegarder la note"
            android:backgroundTint="#FF1493"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📚 Tes notes"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FF1493"
            android:layout_marginTop="24dp"/>

        <LinearLayout
            android:id="@+id/llNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:spacing="12dp"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</ScrollView>
