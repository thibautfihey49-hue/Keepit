<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/contact_card_bg"
    android:padding="16dp"
    android:elevation="4dp">

    <TextView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text="C"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:background="@drawable/avatar_bg"
        android:layout_marginEnd="14dp"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">
        <TextView android:id="@+id/tvName" android:textSize="16sp" android:textColor="#FFFFFF" android:textStyle="bold"/>
        <TextView android:id="@+id/tvNumber" android:textSize="13sp" android:textColor="#999999" android:layout_marginTop="2dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnDeleteContact"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="🗑️"
        android:textSize="14sp"
        android:background="@drawable/btn_delete_small_bg"
        android:textColor="#FFFFFF"
        android:minWidth="48dp"
        android:paddingHorizontal="12dp"/>
</LinearLayout>
