<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#1E1E1E"
    android:padding="16dp">

    <TextView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="C"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:background="#FF1493"
        android:layout_marginEnd="12dp"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/tvName" android:textSize="16sp" android:textColor="#FFFFFF" android:textStyle="bold"/>
        <TextView android:id="@+id/tvNumber" android:textSize="13sp" android:textColor="#888888" android:layout_marginTop="2dp"/>
    </LinearLayout>

    <Button android:id="@+id/btnDeleteContact" android:text="🗑️" android:backgroundTint="#F44336" android:textColor="#FFFFFF" android:minWidth="40dp"/>
</LinearLayout>
